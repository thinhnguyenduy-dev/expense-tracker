# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# Read-only connection for the data_analyst AI agent. Connect as the `analyst_ro`
# role created by the analyst-rls migration (alembic upgrade head). Row-level
# security on this role hard-bounds the agent's SQL to the requesting user.
# If unset, the analyst falls back to DATABASE_URL and relies only on an
# in-process string guard for user scoping.
# ANALYST_DATABASE_URL=postgresql://analyst_ro:analyst_ro_dev_pw@localhost:5432/expense_tracker
# Password used when the migration auto-creates the analyst_ro role:
# ANALYST_DB_PASSWORD=analyst_ro_dev_pw

# JWT - CHANGE IN PRODUCTION!
JWT_SECRET=your-secret-key-change-it
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Sentry (optional)
SENTRY_DSN=

# ELK Stack (optional)
ELASTICSEARCH_URL=https://your-elasticsearch-url.com
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
KIBANA_URL=https://your-kibana-url.com
ELK_ENABLED=false

# AI Provider (openai, google, anthropic, groq)
AI_PROVIDER=openai
# OpenAI / Groq
OPENAI_API_KEY=your_api_key
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL_NAME=llama-3.3-70b-versatile

# Google (Gemini)
# GOOGLE_API_KEY=your_google_key
# GOOGLE_MODEL_NAME=gemini-1.5-flash

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_MODEL_NAME=claude-3-sonnet-20240229

# data_analyst: how much of its SQL tool-call trace to merge back into shared state
#   last_message = only the final answer (clean history, fewer tokens) — default
#   full_history = the entire AI/Tool chain (full trace, useful for debugging)
ANALYST_OUTPUT_MODE=last_message